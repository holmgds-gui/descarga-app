{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Descarga",
  "version": "1.0.0",
  "identifier": "app.descarga.desktop",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Descarga",
        "url": "https://holmgds-gui.github.io/descarga-app/",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Descarga",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
